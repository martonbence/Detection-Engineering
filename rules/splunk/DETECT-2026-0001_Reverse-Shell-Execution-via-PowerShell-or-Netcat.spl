index=sysmon (OriginalFileName IN ("PowerShell.EXE", "pwsh.dll") OR Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*New-Object Net.Sockets.TCPClient*", "*System.Net.Sockets.TCPClient*", "*System.Net.Sockets.NetworkStream*", "*Invoke-PowerShellTcp*", "*Invoke-PowerShellTcpOneLine*", "*Invoke-PowerShellTcpOneLineBind*", "*Invoke-PowerShellUdp*", "*Invoke-PowerShellUdpOneLine*", "*Invoke-PowerShellIcmp*", "*Invoke-ConPtyShell*", "*Invoke-PoshRatHttp*", "*Invoke-PowerShellWmi*", "*Invoke-JSRatRegsvr*", "*Invoke-JSRatRundll*", "*Out-RundllCommand*", "*powercat*", "*Start-PowerCat*", "*Connect-PowerCat*") OR (CommandLine="* Net.Sockets.TCPClient*" CommandLine="*.GetStream(*" CommandLine="*.Write(*")) OR (Image IN ("*\\nc.exe", "*\\ncat.exe", "*\\nc64.exe", "*\\netcat.exe") CommandLine IN ("* -e *", "* --exec *", "* --lua-exec *", "* --sh-exec *", "* -lvp *", "* -lvnp *", "* -l -v -p *", "* -lv -p *")) OR (CommandLine="*msfvenom*" CommandLine="* -p *" CommandLine IN ("*reverse_tcp*", "*reverse_http*", "*reverse_https*", "*reverse_powershell*", "*bind_tcp*", "*shell_reverse*", "*shell_bind*")) | table _time,ComputerName,User,Image,OriginalFileName,CommandLine,ParentImage,ParentCommandLine,ProcessId,ParentProcessId
