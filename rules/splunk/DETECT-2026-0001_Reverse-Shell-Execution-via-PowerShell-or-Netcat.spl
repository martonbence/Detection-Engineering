index=sysmon (OriginalFileName IN ("PowerShell.EXE", "pwsh.dll") OR Image IN ("*\\powershell.exe", "*\\pwsh.exe") CommandLine IN ("*New-Object Net.Sockets.TCPClient*", "*System.Net.Sockets.TCPClient*", "*System.Net.Sockets.NetworkStream*", "*Invoke-PowerShellTcp*", "*Invoke-PowerShellTcpOneLine*", "*Invoke-PowerShellTcpOneLineBind*", "*Invoke-PowerShellUdp*", "*Invoke-PowerShellUdpOneLine*", "*Invoke-PowerShellIcmp*", "*Invoke-ConPtyShell*", "*Invoke-PoshRatHttp*", "*Invoke-PowerShellWmi*", "*Invoke-JSRatRegsvr*", "*Invoke-JSRatRundll*", "*Out-RundllCommand*", "*powercat*", "*Start-PowerCat*", "*Connect-PowerCat*") OR (CommandLine="* Net.Sockets.TCPClient*" CommandLine="*.GetStream(*" CommandLine="*.Write(*")) OR (Image IN ("*\\nc.exe", "*\\ncat.exe", "*\\nc64.exe", "*\\netcat.exe") CommandLine IN ("* -e*", "* --exec*", "* --lua-exec*", "* --sh-exec*", "* -lvp*", "* -lvnp*")) OR (CommandLine="*msfvenom*" CommandLine="*-p*") | table _time,ComputerName,User,Image,OriginalFileName,CommandLine,ParentImage,ParentCommandLine,ProcessId,ParentProcessId
