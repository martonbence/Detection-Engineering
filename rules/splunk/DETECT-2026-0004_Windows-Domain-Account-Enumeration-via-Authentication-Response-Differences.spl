index=wineventlog source="wineventlog:security" (EventCode=4625 Sub_Status="0xC0000064") OR (EventCode=4768 Result_Code="0x6") OR (EventCode=4776 Error_Code="0xC0000064") | eval target_account=case(EventCode=4625, mvindex(Account_Name, -1), EventCode=4768, Account_Name, EventCode=4776, Logon_Account) | eval target_account=lower(replace(target_account, "@.*$", "")) | where NOT match(target_account, "\$$") | eval src_identifier=coalesce(if(Workstation_Name!="" AND Workstation_Name!="-", Workstation_Name, null()), if(Source_Workstation!="" AND Source_Workstation!="-", Source_Workstation, null()), if(Source_Network_Address!="127.0.0.1" AND Source_Network_Address!="::1" AND Source_Network_Address!="-", Source_Network_Address, null()), if(Client_Address!="::1" AND Client_Address!="127.0.0.1" AND Client_Address!="-", Client_Address, null())) | eval src_ip=coalesce(if(Source_Network_Address!="127.0.0.1" AND Source_Network_Address!="::1" AND Source_Network_Address!="-", Source_Network_Address, null()), if(Client_Address!="::1" AND Client_Address!="127.0.0.1" AND Client_Address!="-", Client_Address, null())) | sort 0 _time | streamstats time_window=5m dc(target_account) as distinct_invalid_accounts, count as attempt_count, values(target_account) as probed_accounts, values(host) as dc_host, values(src_ip) as src_ip by src_identifier | where distinct_invalid_accounts >= 15 | stats latest(_time) as _time, max(distinct_invalid_accounts) as distinct_invalid_accounts, max(attempt_count) as attempt_count, values(probed_accounts) as probed_accounts, values(dc_host) as dc_host, values(src_ip) as src_ip by src_identifier | sort - distinct_invalid_accounts | table _time, src_identifier, src_ip, dc_host, distinct_invalid_accounts, attempt_count, probed_accounts
