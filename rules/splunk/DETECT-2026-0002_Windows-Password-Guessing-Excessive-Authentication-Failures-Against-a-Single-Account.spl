index=wineventlog source="wineventlog:security" (EventCode=4625 Sub_Status="0xC000006A") OR (EventCode=4771 Failure_Code="0x18") OR (EventCode=4776 Error_Code="0xC000006A") | eval target_account=case(EventCode=4625, mvindex(Account_Name, -1), EventCode=4771, Account_Name, EventCode=4776, Logon_Account) | eval target_account=lower(replace(target_account, "@.*$", "")) | where NOT match(target_account, "\$$") | eval src_identifier=coalesce(if(Source_Network_Address!="127.0.0.1" AND Source_Network_Address!="::1" AND Source_Network_Address!="-", Source_Network_Address, null()), if(Client_Address!="::1" AND Client_Address!="127.0.0.1" AND Client_Address!="-", Client_Address, null()), Workstation_Name, Source_Workstation) | bin _time span=5m | stats count as failure_count, dc(src_identifier) as distinct_sources, values(src_identifier) as sources, values(EventCode) as event_codes by target_account, _time | where failure_count >= 10 | sort - failure_count | table _time, target_account, failure_count, distinct_sources, sources, event_codes
