index=main sourcetype=access_combined | eval uri_path_lc=lower(uri_path) | eval is_exec_ext=if(match(uri_path_lc, "\.(php[3457]?|phtml|phar|pht|asp|aspx|jsp|jspx|jspa|cgi|py|sh|rb|cfm|shtml)(\..+)?$"), 1, 0) | eval is_upload_dir=if(match(uri_path_lc, "(^|/)(uploads?|files?|file-manager|tmp)(/|$)"), 1, 0) | eval is_upload_event=if(method="POST" AND is_exec_ext=1 AND is_upload_dir=1 AND (status="200" OR status="201") AND (isnull(bytes) OR bytes<5000), 1, 0) | eval is_access_event=if(method="GET" AND is_exec_ext=1, 1, 0) | where is_upload_event=1 OR is_access_event=1 | sort 0 _time | streamstats current=f last(eval(if(is_upload_event=1, _time, null()))) as last_upload_time by clientip uri_path | where is_access_event=1 AND isnotnull(last_upload_time) AND (_time - last_upload_time) <= 900 | eval duration=_time - last_upload_time | dedup clientip uri_path | table _time, host, clientip, method, uri_path, uri_query, status, bytes, useragent, referer, duration
