index=main (sourcetype=linux_audit key IN (credential_access_ptrace, credential_access_procmem)) | eval detection_reason=if(key="credential_access_ptrace", "ptrace_syscall", "process_vm_readv_syscall") | table _time, detection_reason, key, comm, exe, uid, auid, pid, success | append
    [ search index=main sourcetype=linux_audit (key=procfs_mem_access) OR (type=PATH name="/proc/*/mem")
    | rex field=_raw "audit\((?<audit_ts>[\d\.]+):(?<audit_serial>\d+)\)"
    | eval audit_id=audit_ts."_".audit_serial
    | rex field=name "^/proc/(?<target_pid>\d+)/mem$"
    | stats values(comm) as comm, values(exe) as exe, values(uid) as uid, values(auid) as auid, values(pid) as pid, values(name) as target_path, values(target_pid) as target_pid by audit_id, _time
    | where isnotnull(target_pid) AND isnotnull(comm)
    | where mvindex(pid,0)!=mvindex(target_pid,0)
    | eval detection_reason="procfs_mem_open"
    | table _time, detection_reason, comm, exe, uid, auid, pid, target_path, target_pid ]
| sort - _time
