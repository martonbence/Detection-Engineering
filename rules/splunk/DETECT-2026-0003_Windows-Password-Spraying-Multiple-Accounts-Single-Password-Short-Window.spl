index=wineventlog source="wineventlog:security" (EventCode=4625 Sub_Status="0xC000006A") OR (EventCode=4771 Failure_Code="0x18") OR (EventCode=4776 Error_Code="0xC000006A") | eval target_account=case(EventCode=4625, mvindex(Account_Name, -1), EventCode=4771, Account_Name, EventCode=4776, Logon_Account) | eval target_account=lower(replace(target_account, "@.*$", "")) | where NOT match(target_account, "\$$") | eval src_identifier=coalesce(if(Workstation_Name!="" AND Workstation_Name!="-", Workstation_Name, null()), if(Source_Workstation!="" AND Source_Workstation!="-", Source_Workstation, null()), if(Source_Network_Address!="127.0.0.1" AND Source_Network_Address!="::1" AND Source_Network_Address!="-", Source_Network_Address, null()), if(Client_Address!="::1" AND Client_Address!="127.0.0.1" AND Client_Address!="-", Client_Address, null())) | eval src_ip=coalesce(if(Source_Network_Address!="127.0.0.1" AND Source_Network_Address!="::1" AND Source_Network_Address!="-", Source_Network_Address, null()), if(Client_Address!="::1" AND Client_Address!="127.0.0.1" AND Client_Address!="-", Client_Address, null())) | sort 0 _time | streamstats time_window=10m dc(target_account) as distinct_accounts, count as attempt_count, values(target_account) as targeted_accounts, values(src_ip) as src_ip by src_identifier | where distinct_accounts >= 8 | stats latest(_time) as _time, max(distinct_accounts) as distinct_accounts, max(attempt_count) as attempt_count, values(targeted_accounts) as targeted_accounts, values(src_ip) as src_ip by src_identifier | sort - distinct_accounts | table _time, src_identifier, src_ip, distinct_accounts, attempt_count, targeted_accounts
