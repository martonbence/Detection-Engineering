index=sysmon ((EventCode=1 (Image="*\\powershell.exe" OR Image="*\\pwsh.exe" OR OriginalFileName="PowerShell.EXE" OR OriginalFileName="pwsh.dll") (CommandLine="*Get-Keystrokes*" OR CommandLine="*Keylogger.ps1*" OR CommandLine="*GetAsyncKeyState*" OR CommandLine="*SetWindowsHookEx*" OR CommandLine="*RegisterRawInputDevices*" OR CommandLine="*Windows.Input.Keyboard]::IsKeyDown*")) OR (EventCode=11 (Image="*\\powershell.exe" OR Image="*\\pwsh.exe") TargetFilename="*\\key.log")) | eval detection_branch=case(EventCode=11, "keystroke_log_file", match(CommandLine, "(?i)get-keystrokes|keylogger[.]ps1"), "known_keylogger_tool", true(), "keystroke_api_inline") | table _time, ComputerName, User, EventCode, detection_branch, Image, OriginalFileName, CommandLine, ParentImage, ParentCommandLine, TargetFilename, ProcessId
