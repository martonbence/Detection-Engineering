index=sysmon CommandLine IN ("*Invoke-Inveigh*", "*Invoke-InveighRelay*") OR OriginalFileName IN ("Inveigh.exe", "Inveigh.dll") OR (Image="*\\Inveigh.exe" CommandLine="*Inveigh*") OR CommandLine IN ("*Responder.py*", "*responder.py*") OR CommandLine="*ntlmrelayx*" OR Image="*\\ntlmrelayx.exe" | table _time,ComputerName,User,Image,OriginalFileName,CommandLine,ParentImage,ParentCommandLine,ProcessId
