index=sysmon Image IN ("*\\tshark.exe", "*\\dumpcap.exe", "*\\windump.exe", "*\\Wireshark.exe", "*\\RawCap.exe") OR OriginalFileName IN ("tshark.exe", "dumpcap.exe", "WinDump.exe", "Wireshark.exe", "RawCap.exe") OR Image="*\\pktmon.exe" OR OriginalFileName="PktMon.exe" OR (Image="*\\netsh.exe" CommandLine="*trace*" CommandLine="*start*" CommandLine="*capture=yes*") OR CommandLine IN ("*New-NetEventSession*", "*Add-NetEventPacketCaptureProvider*", "*Start-NetEventSession*") | table _time,ComputerName,User,Image,OriginalFileName,CommandLine,ParentImage,ParentCommandLine,ProcessId
