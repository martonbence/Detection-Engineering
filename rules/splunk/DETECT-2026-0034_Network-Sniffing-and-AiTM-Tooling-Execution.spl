index=sysmon (Image="*\\netsh.exe" CommandLine="*trace*" CommandLine="*start*") OR (Image="*\\pktmon.exe" CommandLine IN ("*start*", "*filter*")) OR Image IN ("*\\dumpcap.exe", "*\\tshark.exe") OR (CommandLine="*NetEventSession*" CommandLine="*NetEventPacketCaptureProvider*") OR CommandLine="*Invoke-Inveigh*" OR CommandLine IN ("*Responder.py*", "*responder.py*") OR CommandLine="*ntlmrelayx*" | table _time,ComputerName,User,Image,CommandLine,ParentImage,ProcessId
