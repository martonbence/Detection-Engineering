index=sysmon (QueryName=* QueryStatus!="0") OR (DestinationPort=445 Initiated="true" NOT DestinationIp IN ("192.0.2.10", "192.0.2.11")) | eval evtype=if(isnotnull(QueryStatus), "dnsfail", "smb") | eval dq_time=if(evtype="dnsfail", _time, null()), dq_name=if(evtype="dnsfail", QueryName, null()), dq_status=if(evtype="dnsfail", QueryStatus, null()), dq_image=if(evtype="dnsfail", Image, null()), dq_user=if(evtype="dnsfail", User, null()) | sort 0 +_time, +evtype | streamstats time_window=10s latest(dq_time) as dnsfail_time, latest(dq_name) as failed_name, latest(dq_status) as failed_status, latest(dq_image) as dns_image, latest(dq_user) as dns_user by ComputerName | where evtype="smb" AND isnotnull(dnsfail_time) AND (_time - dnsfail_time) <= 10 | eval lag_seconds=round(_time - dnsfail_time, 3) | rename Image as smb_image, User as smb_user | dedup ComputerName, DestinationIp | table _time, ComputerName, lag_seconds, failed_name, failed_status, dns_image, dns_user, smb_image, smb_user, DestinationIp, DestinationPort
