index=sysmon (EventCode=22 QueryStatus!=0) OR (EventCode=3 DestinationPort=445 Initiated="true") | transaction ComputerName startswith=(EventCode=22) endswith=(EventCode=3) maxspan=10s | where eventcount=2 | eval QueryName=mvindex(QueryName,0), DestinationIp=mvindex(DestinationIp,0), DestinationPort=mvindex(DestinationPort,0), Image=mvindex(Image,0), User=mvindex(User,0) | lookup known_smb_servers.csv ip AS DestinationIp OUTPUT is_known_server | where isnull(is_known_server) | table _time, ComputerName, User, QueryName, DestinationIp, DestinationPort, Image
