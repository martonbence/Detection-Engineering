{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git commit *)",
      "Bash(python scripts/validate/*)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/docs-drift-check.sh",
            "timeout": 20,
            "statusMessage": "Checking whether docs need updating after this commit..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 .claude/hooks/log_subagent_usage.py",
            "timeout": 15,
            "statusMessage": "Logging subagent usage..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 .claude/hooks/log_session_usage.py",
            "timeout": 30,
            "statusMessage": "Logging lead-session usage..."
          }
        ]
      }
    ]
  }
}
