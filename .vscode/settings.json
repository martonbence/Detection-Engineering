{
    "files.associations": {
        "**/*.spl": "plaintext",
        "rules/**/*.yml": "yaml",
        "rules/**/*.yaml": "yaml"
    },
    "yaml.schemas": {
        "docs/schemas/sigma_schema.json": [
            "rules/**/*.yml",
            "rules/**/*.yaml"
        ]
    },
    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.defaultColorDecorators": "never",
        "editor.snippetSuggestions": "inline",
        "editor.quickSuggestions": {
            "strings": "on"
        }
    },
    // Elrejti a fastruktúrából, amit a .gitignore kizár: __pycache__,
    // .pytest_cache, .ruff_cache, pipeline_bundle, outputs/state,
    // outputs/deploy és a rules/splunk/*.meta.json melléklapok.
    // Nem érti a tagadó mintákat (!valami) -- ha a .gitignore-ba kerül ilyen,
    // az a fájl itt rejtve marad.
    "explorer.excludeGitIgnore": true,
    "editor.formatOnSave": true,
    "files.trimTrailingWhitespace": true,
    "editor.rulers": [
        80,
        120
    ]
}