rules/splunk/*.meta.json
pipeline_bundle/

# Splunk reconciliation output. Describes the Splunk instance at one moment,
# not the repo -- committing it would add a commit per run that says nothing
# about the code. It travels as a build artifact instead. Deliberately not
# under outputs/reports/, which the verify job stages wholesale with
# `git add outputs/reports/`.
outputs/state/

# Prod deploy report. Same reasoning as outputs/state/ above: it records one
# run against one Splunk instance, not the state of the repo. It travels as a
# build artifact, and the prod job cannot commit anyway (contents: read).
outputs/deploy/

# Python build/test leftovers. Nothing imported anything until tests/ existed,
# so these never appeared before.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# npm leftovers from running the rule-browser smoke test locally
# (scripts/docs/smoke_test_rule_browser.js, register item 4.7). There is no
# package.json in this repo -- see ci_code_checks.yml's "Install Playwright"
# step -- so nothing else already keeps this out.
node_modules/

# Obsidian vault (personal/MITRE-Notes/). The notes themselves are versioned -- they are
# the point -- but a few files under .obsidian/ describe the editor session
# rather than the notes: workspace.json is rewritten every time a pane is
# opened, closed or resized, so on a multi-device setup it produces a commit
# per session and a merge conflict per sync, none of which say anything about
# the content. The rest of .obsidian/ (app.json, appearance.json,
# core-plugins.json, graph.json, templates.json) is deliberately kept: those
# are real settings that should follow the vault to the other machine.
personal/MITRE-Notes/.obsidian/workspace.json
personal/MITRE-Notes/.obsidian/workspace-mobile.json
personal/MITRE-Notes/.obsidian/cache
personal/MITRE-Notes/.trash/
